{
  "expo": {
    "name": "CADENIQUE",
    "slug": "cadenique",
    "version": "0.0.1",
    "icon": "./assets/branding/icons/cadenique-icon.png",
    "splash": {
      "image": "./assets/images/Splashs creen/Écran Splash Néon du Coureur.png",
      "resizeMode": "cover",
      "backgroundColor": "#020500"
    },
    "scheme": "cadenique",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cadenique.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.cadenique.app",
      "googleServicesFile": "./google-services.json",
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "CADENIQUE needs camera access to guide and capture your body scan.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}