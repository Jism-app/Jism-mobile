{
  "expo": {
    "name": "CADENIQUE",
    "slug": "cadenique",
    "version": "0.0.1",
    "scheme": "cadenique",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cadenique.app"
    },
    "android": {
      "package": "com.cadenique.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "PhysiqueAI needs camera access to guide and capture your body scan.",
          "enableMicrophonePermission": false
        }
      ]
    ]
  }
}